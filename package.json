{
  "name": "peace-music",
  "version": "1.0.0",
  "description": "Peace music - standalone music bot (play-dl + @discordjs/voice + yt-dlp). Split from the main PeaceX bot, which is now security + utility only.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node scripts/deploy.js",
    "deploy:guild": "node scripts/deploy.js --guild-only",
    "deploy:global": "node scripts/deploy.js --pure-global",
    "spotify": "node scripts/spotify.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@flytri/lyrics-finder": "^1.0.7",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.15.3",
    "dotenv": "^17.4.2",
    "mongodb": "^7.6.0",
    "musicard": "^3.0.1",
    "musicard-quartz": "^1.0.0",
    "play-dl": "^1.9.7",
    "prism-media": "^1.3.5",
    "yt-dlp-exec": "^1.0.2"
  },
  "allowScripts": {
    "yt-dlp-exec@1.0.2": true,
    "@discordjs/opus@0.10.0": true,
    "protobufjs@7.6.5": true,
    "better-sqlite3@12.11.1": true,
    "canvas@3.2.3": true,
    "esbuild@0.27.7": true
  }
}
