# Peace music - separate bot
# Create your own .env (gitignored). Replace DISCORD_TOKEN + CLIENT_ID with the
# NEW music bot application from https://discord.com/developers/applications
# (do NOT reuse the main PeaceX bot token - Discord disconnects the second login).

DISCORD_TOKEN=your_music_bot_token_here
CLIENT_ID=your_music_bot_application_id_here
OWNER_ID=1202689641757806602
# Optional: link shown by /support
SUPPORT_URL=https://discord.gg/as22hkafWN
# Optional: a server ID to deploy commands instantly while testing
DEV_GUILD_ID=
# Optional: Spotify support for /play <spotify link>.
# Run `npm run spotify` once to authorize (saved to .data/spotify.data).

# Optional: MongoDB for per-user playlists + liked songs (defaults to mongodb://127.0.0.1:27017).
# If unreachable, the bot falls back to the local SQLite/JSON stores.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=peace_music